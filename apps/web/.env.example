# Copy to .env.local for local development. Real values never go in git.
# Only NEXT_PUBLIC_* variables reach the browser — treat them as public.

NEXT_PUBLIC_APP_URL=http://localhost:3000
# Where NestJS runs. Server-side only.
API_URL=http://localhost:4000

# Sentry. Leave unset locally to keep it off. Set per Vercel environment:
# Preview = staging, Production = production.
# NEXT_PUBLIC_SENTRY_DSN=https://...ingest.sentry.io/...
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# Set to true only while checking Sentry on a deployed environment, then redeploy with it off.
SENTRY_TEST_ROUTE=false
