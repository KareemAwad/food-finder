# Copy to .env for local development. Real values never go in git.

# Matches docker-compose.yml. In production, DATABASE_URL is Neon's pooled URL and DIRECT_URL its direct URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/app
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/app
PORT=4000

# Sentry. Leave SENTRY_DSN unset to keep it off locally. Staging and production each set their own.
# SENTRY_DSN=https://...ingest.sentry.io/...
SENTRY_ENVIRONMENT=development
# Set to true only while checking Sentry on a deployed environment, then back to false.
SENTRY_TEST_ROUTE=false
