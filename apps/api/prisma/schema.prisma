// Add models here, then run `pnpm db:migrate`. Every table gets createdAt and updatedAt (standards/database.md).
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// One row per calendar day, counting Google calls so search stops at the daily budget (decisions/006).
model ApiUsageDay {
  id          Int      @id @default(autoincrement())
  day         DateTime @unique @db.Date
  googleCalls Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
